{
  "permissions": {
    "allow": [
      "Bash(scripts/dev/verify.sh)",
      "Bash(scripts/dev/verify.sh *)",
      "Bash(scripts/dev/shot.sh *)",
      "Bash(scripts/log.sh)",
      "Bash(scripts/log.sh *)",
      "Bash(scripts/run_tests.sh)",
      "Bash(scripts/run_tests.sh *)",
      "Bash(scripts/check_all.sh)",
      "Bash(scripts/check_all.sh *)",
      "Bash(scripts/check_qmlformat.sh)",
      "Bash(python3 scripts/check_*.py)",
      "Bash(python3 scripts/check_*.py *)",
      "Bash(python3 scripts/gen_docs.py)",
      "Bash(python3 scripts/gen_docs.py *)",
      "Bash(hyprctl monitors *)",
      "Bash(hyprctl layers *)",
      "Bash(python3 scripts/check_doc_drift.py)",
      "Bash(python3 scripts/check_doc_drift.py *)",
      "Bash(python3 tests/scripts/test_guard.py)",
      "Bash(gh pr merge *)"
    ],
    "deny": [
      "Bash(qs -c axiom ipc call lockscreen lock*)",
      "Bash(qs ipc call lockscreen lock*)",
      "Bash(loginctl lock-session*)",
      "Bash(hyprlock*)",
      "Bash(qs -c axiom ipc call monitors keep*)",
      "Bash(qs ipc call monitors keep*)",
      "Bash(qs -c axiom ipc call selfUpdate update*)",
      "Bash(qs ipc call selfUpdate update*)",
      "Bash(axiom lock*)",
      "Bash(axiom ipc lockscreen*)",
      "Bash(axiom ipc monitors keep*)",
      "Bash(axiom ipc selfUpdate update*)",
      "Bash(ydotool *)",
      "Bash(dotool *)",
      "Bash(wlrctl *)",
      "Bash(hyprctl dispatch movecursor*)",
      "Bash(systemctl restart greetd*)",
      "Bash(systemctl stop greetd*)",
      "Bash(sudo systemctl * greetd*)",
      "Bash(rm config/user/config.json)",
      "Bash(rm -f config/user/config.json)",
      "Bash(rm ~/.config/axiom/config.json)",
      "Bash(rm -f ~/.config/axiom/config.json)",
      "Bash(git clean -fdx*)",
      "Bash(git clean -x*)",
      "Bash(git clean -X*)",
      "Bash(qmlformat -i *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
