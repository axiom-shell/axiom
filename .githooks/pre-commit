#!/usr/bin/env bash
# Regenerates what's built from the code being committed (the index, not the
# working tree) and stages it, so a commit never carries stale output:
#   - the translations (scripts/check_i18n.py --fill --prune): every new key,
#     empty, in each config/i18n/<code>.json, every key nothing uses any more
#     dropped from them, and the empty template a new language is copied
#     from, config/i18n/template/language.json
#   - the theme template, config/themes/template/theme.json
#     (scripts/gen_theme_template.py)
# The config schema the translations are made from,
# config/json/config.schema.json, is built from config/schema/ and the
# components' schema.yaml files in the snapshot
# (backend/tools/syncassets, through go generate) and never committed, like the
# reference docs in docs/dev/config and docs/dev/generated (scripts/generate.sh
# builds both in the tree).
# Enabled per clone with
#   git config core.hooksPath .githooks
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

staged="$(git diff --cached --name-only --diff-filter=ACMRD)"
i18n=0 theme=0
grep -qE '^config/schema/|^backend/internal/schema/|^components/.*/schema\.yaml$' <<<"$staged" && i18n=1
grep -qE '\.qml$|^scripts/check_i18n\.py$|^config/i18n/' <<<"$staged" && i18n=1
grep -qE '^config/json/theme-defaults\.json$|^scripts/gen_theme_template\.py$|^config/themes/template/' <<<"$staged" && theme=1
[[ $i18n -eq 1 || $theme -eq 1 ]] || exit 0

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
git checkout-index --all --prefix="$tmp/"

# Into the working tree by rename, so the shell (watching the active
# dictionary) never reads a half-written file
place() {
  cp "$tmp/$1" "$1.tmp"
  mv "$1.tmp" "$1"
  git add "$1"
}

# The schema first: the translations are made from it
if [[ $i18n -eq 1 ]]; then
  if ! command -v go >/dev/null; then
    echo "pre-commit: go isn't installed to build the config schema the translations are made from" >&2
    exit 1
  fi
  (cd "$tmp/backend" && go generate ./internal/assets)
fi

if [[ $i18n -eq 1 && -f "$tmp/scripts/check_i18n.py" ]]; then
  # Exits 1 while entries are untranslated, which is fine to commit
  python3 "$tmp/scripts/check_i18n.py" --fill --prune >/dev/null || true
  template=config/i18n/template/language.json
  mkdir -p "$(dirname "$template")"
  cmp -s "$tmp/$template" <(git show ":$template" 2>/dev/null) || place "$template"
  for file in "$tmp"/config/i18n/*.json; do
    rel="config/i18n/$(basename "$file")"
    cmp -s "$file" <(git show ":$rel") && continue
    # A language file with unstaged edits is left alone: rewriting it from
    # the index would drop them
    if git diff --quiet -- "$rel"; then
      place "$rel"
    else
      echo "pre-commit: $rel has unstaged edits, so its keys weren't brought up to date; stage it and commit again" >&2
      exit 1
    fi
  done
fi

if [[ $theme -eq 1 && -f "$tmp/scripts/gen_theme_template.py" ]]; then
  python3 "$tmp/scripts/gen_theme_template.py" >/dev/null
  template=config/themes/template/theme.json
  mkdir -p "$(dirname "$template")"
  cmp -s "$tmp/$template" <(git show ":$template" 2>/dev/null) || place "$template"
fi
