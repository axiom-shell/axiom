{
  "kind": "sway",
  "supports": {
    "configModes": true,
    "keybinds": true,
    "monitors": true,
    "switcher": true,
    "windowGeometry": true,
    "outputCapture": true,
    "layerFrameSync": true,
    "windowBorders": true,
    "windowShape": true,
    "windowGaps": true,
    "inputConfig": true,
    "keyCapture": true,
    "modifierTap": true,
    "bindMerge": true,
    "scratchpad": true,
    "namedSpecial": true,
    "mouseBinds": true,
    "splitToggle": true,
    "pin": true,
    "windowOpacity": true,
    "windowRounding": true,
    "windowBlur": true,
    "blur": true,
    "windowShadow": true,
    "windowDim": true
  },
  "fx": true,
  "ctx": {
    "axiomPath": "/home/user/.config/quickshell/axiom",
    "axiomBin": "/home/user/.local/bin/axiom",
    "shellCommand": "'/home/user/.local/bin/axiom'",
    "restartCommand": "'/home/user/.local/bin/axiom' restart",
    "terminal": "kitty",
    "fileManager": "nemo",
    "browser": "flatpak run app.zen_browser.zen"
  },
  "startPattern": "(^|[\\s'\"/])axiom['\"]? +run\\b",
  "primaryMonitor": "DP-1",
  "look": {
    "active": "#9ccfd8",
    "inactive": "#403d52",
    "borderWidth": 2,
    "radius": 26,
    "shadow": {
      "size": 24,
      "color": "#ffffff",
      "alpha": 1,
      "soft": true,
      "strength": 0.9
    }
  },
  "blur": {
    "saved": true,
    "now": true,
    "throughWindows": true,
    "backdrops": true,
    "threshold": 0.5
  },
  "xcursor": "axiom-cursor-Oxygen_White",
  "palette": {
    "base00": "#191724"
  },
  "motion": {
    "fast": 100,
    "normal": 150,
    "slow": 300,
    "enabled": true
  },
  "previews": []
}
