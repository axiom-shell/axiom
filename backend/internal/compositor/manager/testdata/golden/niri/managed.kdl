// Generated by axiom (niri mode: managed) from its settings, and
// rewritten whenever they (or the theme) change: edit those, not this file.
// Your own config goes in /nonexistent/home/.config/niri/user/ as .kdl files, included after
// axiom's binds in name order: your binds win over axiom's, axiom's look
// and settings over yours.

binds {
    Super+Ctrl+S hotkey-overlay-title="Apps: Screenshot: region" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "screenshot" "take" "region"
    }
    Super+WheelScrollDown hotkey-overlay-title="Window: Focus right" repeat=false cooldown-ms=150 {
        focus-column-or-monitor-right
    }
    Super+WheelScrollUp hotkey-overlay-title="Window: Focus left" repeat=false cooldown-ms=150 {
        focus-column-or-monitor-left
    }
    Ctrl+Shift+Tab hotkey-overlay-title="Window: Switch windows backwards" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "windowSwitcher" "previous"
    }
    Super+Shift+R hotkey-overlay-title="Media: Rotate Monitor" repeat=false {
        spawn-sh "/home/user/.config/hypr/user/scripts/rotateMonitor.sh"
    }
    Super+F hotkey-overlay-title="Window: Fullscreen" repeat=false {
        fullscreen-window
    }
    Super+C hotkey-overlay-title="Window: Close" repeat=false {
        close-window
    }
    Super+Z hotkey-overlay-title="Window: Toggle floating" repeat=false {
        toggle-window-floating
    }
    Super+Ctrl+r hotkey-overlay-title="Axiom: Restart shell" repeat=false {
        spawn-sh "'/home/user/.local/bin/axiom' restart"
    }
    Super+Q hotkey-overlay-title="Apps: Terminal" repeat=false {
        spawn-sh "kitty"
    }
    Super+Shift+Q hotkey-overlay-title="Apps: Browser" repeat=false {
        spawn-sh "flatpak run app.zen_browser.zen"
    }
    Super+E hotkey-overlay-title="Apps: File manager" repeat=false {
        spawn-sh "nemo"
    }
    Super+T hotkey-overlay-title="Axiom: kitty --title btop -e btop" repeat=false {
        spawn-sh "kitty --title btop -e btop"
    }
    Super+B hotkey-overlay-title="Apps: pavucontrol" repeat=false {
        spawn-sh "pavucontrol"
    }
    Super+Shift+C hotkey-overlay-title="Apps: element" repeat=false {
        spawn-sh "element-desktop"
    }
    Super+Shift+E hotkey-overlay-title="Apps: vesktop" repeat=false {
        spawn-sh "vesktop"
    }
    Super+Ctrl+Shift+S hotkey-overlay-title="Apps: yank ocr" repeat=false {
        spawn-sh "rm -f /tmp/ocr-input.png /tmp/ocr-done && grim -g \"$(slurp)\" /tmp/ocr-input.png"
    }
    Super+Shift+Escape hotkey-overlay-title="Axiom: Log out" repeat=false {
        quit skip-confirmation=true
    }
    Ctrl+Tab hotkey-overlay-title="Window: Switch windows" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "windowSwitcher" "next"
    }
    Super+1 hotkey-overlay-title="Workspace: Go to workspace 1" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "nth" "1" "go"
    }
    Super+Shift+1 hotkey-overlay-title="Workspace: Move window to workspace 1" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "nth" "1" "move"
    }
    Super+2 hotkey-overlay-title="Workspace: Go to workspace 2" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "nth" "2" "go"
    }
    Super+Shift+2 hotkey-overlay-title="Workspace: Move window to workspace 2" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "nth" "2" "move"
    }
    Super+3 hotkey-overlay-title="Workspace: Go to workspace 3" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "nth" "3" "go"
    }
    Super+Shift+3 hotkey-overlay-title="Workspace: Move window to workspace 3" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "nth" "3" "move"
    }
    Super+4 hotkey-overlay-title="Workspace: Go to workspace 4" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "nth" "4" "go"
    }
    Super+Shift+4 hotkey-overlay-title="Workspace: Move window to workspace 4" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "nth" "4" "move"
    }
    Super+5 hotkey-overlay-title="Workspace: Go to workspace 5" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "nth" "5" "go"
    }
    Super+Shift+5 hotkey-overlay-title="Workspace: Move window to workspace 5" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "nth" "5" "move"
    }
    Super+6 hotkey-overlay-title="Workspace: Go to workspace 6" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "nth" "6" "go"
    }
    Super+Shift+6 hotkey-overlay-title="Workspace: Move window to workspace 6" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "nth" "6" "move"
    }
    Super+7 hotkey-overlay-title="Workspace: Go to workspace 7" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "nth" "7" "go"
    }
    Super+Shift+7 hotkey-overlay-title="Workspace: Move window to workspace 7" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "nth" "7" "move"
    }
    Super+8 hotkey-overlay-title="Workspace: Go to workspace 8" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "nth" "8" "go"
    }
    Super+Shift+8 hotkey-overlay-title="Workspace: Move window to workspace 8" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "nth" "8" "move"
    }
    Super+9 hotkey-overlay-title="Workspace: Go to workspace 9" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "nth" "9" "go"
    }
    Super+Shift+9 hotkey-overlay-title="Workspace: Move window to workspace 9" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "nth" "9" "move"
    }
    Super+Ctrl+H hotkey-overlay-title="Window: Resize by -50 0" {
        set-column-width "-50"
    }
    Super+Ctrl+J hotkey-overlay-title="Window: Resize by 0 50" {
        set-window-height "+50"
    }
    Super+Ctrl+K hotkey-overlay-title="Window: Resize by 0 -50" {
        set-window-height "-50"
    }
    Super+Ctrl+L hotkey-overlay-title="Window: Resize by 50 0" {
        set-column-width "+50"
    }
    Super+space hotkey-overlay-title="Axiom: App launcher" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "appLauncher" "toggle"
    }
    Super+Escape hotkey-overlay-title="Axiom: Power menu" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "powermenu" "toggle"
    }
    Super+Tab hotkey-overlay-title="Axiom: Overlay" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "overlay" "toggle"
    }
    Super+Shift+space hotkey-overlay-title="Workspace: Workspace overview" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaceOverlay" "toggle"
    }
    XF86AudioRaiseVolume hotkey-overlay-title="Media: Volume up" allow-when-locked=true {
        spawn "/home/user/.local/bin/axiom" "ipc" "audio" "volumeUp"
    }
    XF86AudioLowerVolume hotkey-overlay-title="Media: Volume down" allow-when-locked=true {
        spawn "/home/user/.local/bin/axiom" "ipc" "audio" "volumeDown"
    }
    XF86AudioMute hotkey-overlay-title="Media: Mute" repeat=false allow-when-locked=true {
        spawn "/home/user/.local/bin/axiom" "ipc" "audio" "toggleMute"
    }
    XF86AudioMicMute hotkey-overlay-title="Media: Mute microphone" repeat=false allow-when-locked=true {
        spawn "/home/user/.local/bin/axiom" "ipc" "audio" "toggleMicMute"
    }
    XF86MonBrightnessUp hotkey-overlay-title="Media: Brightness up" allow-when-locked=true {
        spawn "/home/user/.local/bin/axiom" "ipc" "brightness" "up"
    }
    XF86MonBrightnessDown hotkey-overlay-title="Media: Brightness down" allow-when-locked=true {
        spawn "/home/user/.local/bin/axiom" "ipc" "brightness" "down"
    }
    XF86AudioPlay hotkey-overlay-title="Media: Play/Pause" repeat=false allow-when-locked=true {
        spawn "/home/user/.local/bin/axiom" "ipc" "media" "playPause"
    }
    XF86AudioPause hotkey-overlay-title="Media: Play/Pause" repeat=false allow-when-locked=true {
        spawn "/home/user/.local/bin/axiom" "ipc" "media" "playPause"
    }
    XF86AudioNext hotkey-overlay-title="Media: Next track" repeat=false allow-when-locked=true {
        spawn "/home/user/.local/bin/axiom" "ipc" "media" "next"
    }
    XF86AudioPrev hotkey-overlay-title="Media: Previous track" repeat=false allow-when-locked=true {
        spawn "/home/user/.local/bin/axiom" "ipc" "media" "previous"
    }
    XF86AudioStop hotkey-overlay-title="Media: Stop" repeat=false allow-when-locked=true {
        spawn "/home/user/.local/bin/axiom" "ipc" "media" "stop"
    }
    Super+W hotkey-overlay-title="Workspace: Switch up" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "step" "up" "go"
    }
    Super+Shift+W hotkey-overlay-title="Workspace: Move window up" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "step" "up" "move"
    }
    Super+S hotkey-overlay-title="Workspace: Switch down" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "step" "down" "go"
    }
    Super+Shift+S hotkey-overlay-title="Workspace: Move window down" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "step" "down" "move"
    }
    Super+A hotkey-overlay-title="Tiling: Switch left" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "step" "left" "go"
    }
    Super+Shift+A hotkey-overlay-title="Tiling: Move window left" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "step" "left" "move"
    }
    Super+D hotkey-overlay-title="Tiling: Switch right" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "step" "right" "go"
    }
    Super+Shift+D hotkey-overlay-title="Tiling: Move window right" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "step" "right" "move"
    }
    Super+J hotkey-overlay-title="Window: Focus down" repeat=false {
        focus-window-or-monitor-down
    }
    Super+Shift+J hotkey-overlay-title="Window: Move down" repeat=false {
        move-window-down
    }
    Super+K hotkey-overlay-title="Window: Focus up" repeat=false {
        focus-window-or-monitor-up
    }
    Super+Shift+K hotkey-overlay-title="Window: Move up" repeat=false {
        move-window-up
    }
    Super+h hotkey-overlay-title="Window: Focus left" repeat=false {
        focus-column-or-monitor-left
    }
    Super+Shift+h hotkey-overlay-title="Window: Move left" repeat=false {
        move-column-left-or-to-monitor-left
    }
    Super+l hotkey-overlay-title="Window: Focus right" repeat=false {
        focus-column-or-monitor-right
    }
    Super+Shift+l hotkey-overlay-title="Window: Move right" repeat=false {
        move-column-right-or-to-monitor-right
    }
    Super+bracketleft hotkey-overlay-title="Window: Swap column left" repeat=false {
        move-column-left
    }
    Super+bracketright hotkey-overlay-title="Window: Swap column right" repeat=false {
        move-column-right
    }
    Super+equal hotkey-overlay-title="Window: Widen column" repeat=false {
        set-column-width "+10%"
    }
    Super+minus hotkey-overlay-title="Window: Narrow column" repeat=false {
        set-column-width "-10%"
    }
    Super+Ctrl+F hotkey-overlay-title="Window: Fit visible columns" repeat=false {
        expand-column-to-available-width
    }
    Super+0 hotkey-overlay-title="Workspace: Go to workspace 10" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "nth" "10" "go"
    }
    Super+Shift+0 hotkey-overlay-title="Workspace: Move window to workspace 10" repeat=false {
        spawn "/home/user/.local/bin/axiom" "ipc" "workspaces" "nth" "10" "move"
    }
}

// Your files
// (none yet)

output "Example Display 0001" {
    mode "3440x1440@240.000"
    scale 1.0
    transform "normal"
    position x=0 y=0
}
input {
    focus-follows-mouse
    workspace-auto-back-and-forth false
    warp-mouse-to-focus
    keyboard {
        xkb {
            layout "us"
            variant ""
            options ""
        }
        repeat-rate 50
        repeat-delay 300
        numlock true
    }
    mouse {
        accel-profile "flat"
        accel-speed 0.0
    }
    touchpad {
        tap
        dwt
        scroll-factor 0.99
    }
}
cursor {
    hide-when-typing false
    xcursor-theme "axiom-cursor-Oxygen_White"
    xcursor-size 24
}
layout {
    center-focused-column "never"
    always-center-single-column true
    empty-workspace-above-first false
    default-column-display "tabbed"
    default-column-width {
        proportion 0.5
    }
    border {
        active-color "#9ccfd8"
        inactive-color "#403d52"
        on
        width 2
    }
    focus-ring {
        active-color "#9ccfd8"
        inactive-color "#403d52"
        off
    }
    gaps 3
    struts {
        left 3
        right 3
        top 3
        bottom 3
    }
    shadow {
        on
        softness 17
        offset x=0 y=0
        color "#ffffff92"
        inactive-color "#ffffff92"
    }
}
prefer-no-csd true
gestures {
    hot-corners {
        off
    }
}
overview {
    zoom 0.5
}
animations {
    on
    slowdown 0.6
}
hotkey-overlay {
    skip-at-startup true
}
clipboard {
    disable-primary false
}
xwayland-satellite {
    on
}
window-rule {
    geometry-corner-radius 26
    clip-to-geometry true
}
blur {
    passes 2
    offset 5
    noise 0.012
}
window-rule {
    background-effect {
        blur true
        xray true
    }
}
window-rule {
    match is-focused=true
    opacity 1.0
}
window-rule {
    match is-focused=false
    opacity 0.8
}
layer-rule {
    match namespace="^axiom-(blur-backing|dock-preview|overlay|launcher|switcher|floating-popout|notifications|powermenu|workspaces|monitor-prompt)$"
    background-effect {
        xray false
    }
}
layer-rule {
    match namespace="^axiom-(bar|bar-long|bar-pill|bar-pill-long|bar-transparent|bar-transparent-long|bar-floating|bar-floating-long|popout|popout-under|edge-popout|edge-menu|dock)$"
    background-effect {
        xray false
    }
}
layer-rule {
    match namespace="^axiom-(backdrop|polkit)$"
    background-effect {
        xray false
    }
}
layer-rule {
    match namespace="^axiom-(blur-backing-overlay)$"
    background-effect {
        xray false
    }
}
environment {
    GDK_BACKEND "wayland,x11,*"
    QT_QPA_PLATFORM "wayland;xcb"
    CLUTTER_BACKEND "wayland"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_AUTO_SCREEN_SCALE_FACTOR "1"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    QT_QPA_PLATFORMTHEME "qt5ct"
    XCURSOR_THEME "axiom-cursor-Oxygen_White"
    XCURSOR_SIZE "24"
    XDG_CONFIG_HOME "/home/user/.config"
}
spawn-sh-at-startup "'/home/user/.local/bin/axiom' run"
spawn-sh-at-startup "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP"
spawn-sh-at-startup "systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP"
spawn-sh-at-startup "nm-applet"
spawn-sh-at-startup "tailscale systray"
spawn-sh-at-startup "fcitx5 -d --replace"
spawn-sh-at-startup "xrandr --output DP-1 --primary"
spawn-sh-at-startup "easyeffects --gapplication-service"
spawn-sh-at-startup "wl-paste --type text --watch cliphist store"
spawn-sh-at-startup "protonmail-bridge --no-window"
