# Generated by axiom from the "${THEME_NAME}" theme.
# Rewritten on every theme change: edit the template instead.
# A KDE color scheme (KColorScheme: Dolphin, Gwenview, Okular, Kate, ...),
# colors as r,g,b.

[ColorEffects:Disabled]
Color=${BACKGROUND}
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=${BACKGROUND}
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate=${BACKGROUND_HIGHLIGHT}
BackgroundNormal=${BACKGROUND_ALT}
DecorationFocus=${ACCENT}
DecorationHover=${ACCENT}
ForegroundActive=${ACCENT}
ForegroundInactive=${FOREGROUND_INACTIVE}
ForegroundLink=${ACCENT}
ForegroundNegative=${ERROR}
ForegroundNeutral=${WARNING}
ForegroundNormal=${FOREGROUND}
ForegroundPositive=${SUCCESS}
ForegroundVisited=${ACCENT_ALT}

[Colors:Complementary]
BackgroundAlternate=${BACKGROUND_HIGHLIGHT}
BackgroundNormal=${BACKGROUND_ALT}
DecorationFocus=${ACCENT}
DecorationHover=${ACCENT}
ForegroundActive=${ACCENT}
ForegroundInactive=${FOREGROUND_INACTIVE}
ForegroundLink=${ACCENT}
