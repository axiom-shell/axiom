{
  "name": "Axiom",
  "type": "${COLOR_SCHEME}",
  "$comment": "Generated by axiom from the ${THEME_NAME} theme. Rewritten on every theme change.",
  "colors": {
    "foreground": "${FOREGROUND}",
    "focusBorder": "${BORDER_FOCUS}",
    "selection.background": "${BACKGROUND_HIGHLIGHT}",
    "widget.border": "${BORDER}",
    "editor.background": "${BACKGROUND}",
    "editor.foreground": "${FOREGROUND}",
    "editor.lineHighlightBackground": "${BACKGROUND_ALT}",
    "editor.selectionBackground": "${BACKGROUND_HIGHLIGHT}",
    "editor.findMatchHighlightBackground": "${WARNING}55",
    "editorCursor.foreground": "${ACCENT}",
    "editorLineNumber.foreground": "${FOREGROUND_INACTIVE}",
    "editorLineNumber.activeForeground": "${ACCENT}",
    "editorIndentGuide.background1": "${BACKGROUND_HIGHLIGHT}",
    "editorWhitespace.foreground": "${BACKGROUND_HIGHLIGHT}",
    "editorError.foreground": "${ERROR}",
    "editorWarning.foreground": "${WARNING}",
    "editorInfo.foreground": "${INFO}",
    "editorGutter.addedBackground": "${SUCCESS}",
    "editorGutter.deletedBackground": "${ERROR}",
    "editorGutter.modifiedBackground": "${WARNING}",
    "editorWidget.background": "${BACKGROUND_ALT}",
    "editorGroupHeader.tabsBackground": "${BACKGROUND_ALT}",
    "tab.activeBackground": "${BACKGROUND}",
    "tab.activeForeground": "${FOREGROUND}",
    "tab.activeBorderTop": "${ACCENT}",
    "tab.inactiveBackground": "${BACKGROUND_ALT}",
    "tab.inactiveForeground": "${FOREGROUND_INACTIVE}",
    "tab.border": "${BACKGROUND_ALT}",
    "activityBar.background": "${BACKGROUND_ALT}",
    "activityBar.foreground": "${FOREGROUND}",
    "activityBar.inactiveForeground": "${FOREGROUND_INACTIVE}",
    "activityBarBadge.background": "${ACCENT}",
    "activityBarBadge.foreground": "${BACKGROUND}",
    "sideBar.background": "${BACKGROUND_ALT}",
    "sideBar.foreground": "${FOREGROUND}",
    "sideBarSectionHeader.background": "${BACKGROUND_ALT}",
    "list.activeSelectionBackground": "${BACKGROUND_HIGHLIGHT}",
    "list.activeSelectionForeground": "${FOREGROUND_HIGHLIGHT}",
    "list.hoverBackground": "${BACKGROUND_HIGHLIGHT}",
    "list.highlightForeground": "${ACCENT}",
    "titleBar.activeBackground": "${BACKGROUND_ALT}",
    "titleBar.activeForeground": "${FOREGROUND}",
    "titleBar.inactiveBackground": "${BACKGROUND_ALT}",
    "titleBar.inactiveForeground": "${FOREGROUND_INACTIVE}",
    "statusBar.background": "${BACKGROUND_ALT}",
    "statusBar.foreground": "${FOREGROUND}",
    "statusBar.noFolderBackground": "${BACKGROUND_ALT}",
    "statusBar.debuggingBackground": "${WARNING}",
    "statusBar.debuggingForeground": "${BACKGROUND}",
    "panel.background": "${BACKGROUND}",
    "panel.border": "${BORDER}",
    "panelTitle.activeBorder": "${ACCENT}",
    "input.background": "${BACKGROUND}",
    "input.border": "${BORDER}",
    "input.foreground": "${FOREGROUND}",
    "dropdown.background": "${BACKGROUND_ALT}",
    "button.background": "${ACCENT}",
    "button.foreground": "${BACKGROUND}",
    "badge.background": "${ACCENT}",
    "badge.foreground": "${BACKGROUND}",
    "progressBar.background": "${ACCENT}",
    "textLink.foreground": "${ACCENT}",
    "gitDecoration.addedResourceForeground": "${SUCCESS}",
    "gitDecoration.modifiedResourceForeground": "${WARNING}",
    "gitDecoration.deletedResourceForeground": "${ERROR}",
    "gitDecoration.untrackedResourceForeground": "${INFO}",
    "terminal.background": "${BACKGROUND}",
    "terminal.foreground": "${FOREGROUND}",
    "terminalCursor.foreground": "${ACCENT}",
    "terminal.ansiBlack": "${ANSI_0}",
    "terminal.ansiRed": "${ANSI_1}",
    "terminal.ansiGreen": "${ANSI_2}",
    "terminal.ansiYellow": "${ANSI_3}",
    "terminal.ansiBlue": "${ANSI_4}",
    "terminal.ansiMagenta": "${ANSI_5}",
    "terminal.ansiCyan": "${ANSI_6}",
    "terminal.ansiWhite": "${ANSI_7}",
    "terminal.ansiBrightBlack": "${ANSI_8}",
    "terminal.ansiBrightRed": "${ANSI_9}",
    "terminal.ansiBrightGreen": "${ANSI_10}",
    "terminal.ansiBrightYellow": "${ANSI_11}",
    "terminal.ansiBrightBlue": "${ANSI_12}",
    "terminal.ansiBrightMagenta": "${ANSI_13}",
    "terminal.ansiBrightCyan": "${ANSI_14}",
    "terminal.ansiBrightWhite": "${ANSI_15}"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "${FOREGROUND_INACTIVE}", "fontStyle": "italic" } },
    { "scope": ["string"], "settings": { "foreground": "${GREEN}" } },
    { "scope": ["string.regexp", "constant.character.escape"], "settings": { "foreground": "${CYAN}" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"], "settings": { "foreground": "${ORANGE}" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "${MAGENTA}" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "${FOREGROUND_ALT}" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "${BLUE}" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "${YELLOW}" } },
    { "scope": ["variable"], "settings": { "foreground": "${FOREGROUND}" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "${FOREGROUND_ALT}", "fontStyle": "italic" } },
    { "scope": ["variable.language"], "settings": { "foreground": "${RED}" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "${RED}" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "${YELLOW}" } },
    { "scope": ["entity.name.namespace", "entity.name.module"], "settings": { "foreground": "${CYAN}" } },
    { "scope": ["invalid"], "settings": { "foreground": "${ERROR}" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "${ACCENT}", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "${BLUE}" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "${SUCCESS}" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "${ERROR}" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "${WARNING}" } }
  ]
}
