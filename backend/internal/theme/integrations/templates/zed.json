{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Axiom",
  "author": "axiom (generated from the ${THEME_NAME} theme; rewritten on every theme change)",
  "themes": [{
    "name": "Axiom",
    "appearance": "${COLOR_SCHEME}",
    "style": {
      "background": "${BACKGROUND_ALT}",
      "surface.background": "${BACKGROUND_ALT}",
      "elevated_surface.background": "${BACKGROUND_ALT}",
      "panel.background": "${BACKGROUND_ALT}",
      "panel.focused_border": "${BORDER_FOCUS}",
      "pane.focused_border": "${BORDER_FOCUS}",
      "border": "${BACKGROUND_HIGHLIGHT}",
      "border.variant": "${BACKGROUND_HIGHLIGHT}",
      "border.focused": "${BORDER_FOCUS}",
      "border.selected": "${ACCENT}",
      "border.transparent": "#00000000",
      "border.disabled": "${BACKGROUND_HIGHLIGHT}",
      "element.background": "${BACKGROUND_HIGHLIGHT}",
      "element.hover": "${BACKGROUND_HIGHLIGHT}",
      "element.active": "${ACCENT}40",
      "element.selected": "${ACCENT}33",
      "element.disabled": "${BACKGROUND_ALT}",
      "ghost_element.background": "#00000000",
      "ghost_element.hover": "${BACKGROUND_HIGHLIGHT}",
      "ghost_element.active": "${ACCENT}40",
      "ghost_element.selected": "${ACCENT}33",
      "ghost_element.disabled": "#00000000",
      "drop_target.background": "${ACCENT}33",
      "text": "${FOREGROUND}",
      "text.muted": "${FOREGROUND_ALT}",
      "text.placeholder": "${FOREGROUND_INACTIVE}",
      "text.disabled": "${FOREGROUND_INACTIVE}",
      "text.accent": "${ACCENT}",
      "icon": "${FOREGROUND}",
      "icon.muted": "${FOREGROUND_ALT}",
      "icon.disabled": "${FOREGROUND_INACTIVE}",
      "icon.placeholder": "${FOREGROUND_INACTIVE}",
      "icon.accent": "${ACCENT}",
      "link_text.hover": "${ACCENT}",
      "status_bar.background": "${BACKGROUND_ALT}",
      "title_bar.background": "${BACKGROUND_ALT}",
      "title_bar.inactive_background": "${BACKGROUND_ALT}",
      "toolbar.background": "${BACKGROUND}",
      "tab_bar.background": "${BACKGROUND_ALT}",
      "tab.inactive_background": "${BACKGROUND_ALT}",
      "tab.active_background": "${BACKGROUND}",
      "search.match_background": "${WARNING}55",
      "scrollbar.thumb.background": "${FOREGROUND_INACTIVE}66",
      "scrollbar.thumb.hover_background": "${FOREGROUND_INACTIVE}",
      "scrollbar.thumb.border": "#00000000",
      "scrollbar.track.background": "#00000000",
      "scrollbar.track.border": "#00000000",
      "editor.foreground": "${FOREGROUND}",
      "editor.background": "${BACKGROUND}",
      "editor.gutter.background": "${BACKGROUND}",
      "editor.subheader.background": "${BACKGROUND_ALT}",
      "editor.active_line.background": "${BACKGROUND_HIGHLIGHT}80",
      "editor.highlighted_line.background": "${BACKGROUND_HIGHLIGHT}",
      "editor.line_number": "${FOREGROUND_INACTIVE}",
      "editor.active_line_number": "${ACCENT}",
      "editor.invisible": "${BACKGROUND_HIGHLIGHT}",
      "editor.wrap_guide": "${BACKGROUND_HIGHLIGHT}",
      "editor.active_wrap_guide": "${FOREGROUND_INACTIVE}",
      "editor.indent_guide": "${BACKGROUND_HIGHLIGHT}",
      "editor.indent_guide_active": "${FOREGROUND_INACTIVE}",
      "editor.document_highlight.read_background": "${ACCENT}26",
      "editor.document_highlight.write_background": "${ACCENT}40",
      "terminal.background": "${BACKGROUND}",
      "terminal.foreground": "${FOREGROUND}",
      "terminal.bright_foreground": "${FOREGROUND_HIGHLIGHT}",
      "terminal.dim_foreground": "${FOREGROUND_ALT}",
      "terminal.ansi.black": "${ANSI_0}",
      "terminal.ansi.red": "${ANSI_1}",
      "terminal.ansi.green": "${ANSI_2}",
      "terminal.ansi.yellow": "${ANSI_3}",
      "terminal.ansi.blue": "${ANSI_4}",
      "terminal.ansi.magenta": "${ANSI_5}",
      "terminal.ansi.cyan": "${ANSI_6}",
      "terminal.ansi.white": "${ANSI_7}",
      "terminal.ansi.bright_black": "${ANSI_8}",
      "terminal.ansi.bright_red": "${ANSI_9}",
      "terminal.ansi.bright_green": "${ANSI_10}",
      "terminal.ansi.bright_yellow": "${ANSI_11}",
      "terminal.ansi.bright_blue": "${ANSI_12}",
      "terminal.ansi.bright_magenta": "${ANSI_13}",
      "terminal.ansi.bright_cyan": "${ANSI_14}",
      "terminal.ansi.bright_white": "${ANSI_15}",
      "conflict": "${WARNING}",
      "conflict.background": "${WARNING}26",
      "conflict.border": "${WARNING}",
      "created": "${SUCCESS}",
      "created.background": "${SUCCESS}26",
      "created.border": "${SUCCESS}",
      "deleted": "${ERROR}",
      "deleted.background": "${ERROR}26",
      "deleted.border": "${ERROR}",
      "error": "${ERROR}",
      "error.background": "${ERROR}26",
      "error.border": "${ERROR}",
      "hidden": "${FOREGROUND_INACTIVE}",
      "hidden.background": "${FOREGROUND_INACTIVE}26",
      "hidden.border": "${FOREGROUND_INACTIVE}",
      "hint": "${FOREGROUND_INACTIVE}",
      "hint.background": "${FOREGROUND_INACTIVE}26",
      "hint.border": "${FOREGROUND_INACTIVE}",
      "ignored": "${FOREGROUND_INACTIVE}",
      "ignored.background": "${FOREGROUND_INACTIVE}26",
      "ignored.border": "${FOREGROUND_INACTIVE}",
      "info": "${INFO}",
      "info.background": "${INFO}26",
      "info.border": "${INFO}",
      "modified": "${WARNING}",
      "modified.background": "${WARNING}26",
      "modified.border": "${WARNING}",
      "predictive": "${FOREGROUND_INACTIVE}",
      "predictive.background": "${FOREGROUND_INACTIVE}26",
      "predictive.border": "${FOREGROUND_INACTIVE}",
      "renamed": "${INFO}",
      "renamed.background": "${INFO}26",
      "renamed.border": "${INFO}",
      "success": "${SUCCESS}",
      "success.background": "${SUCCESS}26",
      "success.border": "${SUCCESS}",
      "unreachable": "${FOREGROUND_INACTIVE}",
      "unreachable.background": "${FOREGROUND_INACTIVE}26",
      "unreachable.border": "${FOREGROUND_INACTIVE}",
      "warning": "${WARNING}",
      "warning.background": "${WARNING}26",
      "warning.border": "${WARNING}",
      "players": [
        { "cursor": "${ACCENT}", "background": "${ACCENT}", "selection": "${ACCENT}40" },
        { "cursor": "${MAGENTA}", "background": "${MAGENTA}", "selection": "${MAGENTA}40" },
        { "cursor": "${GREEN}", "background": "${GREEN}", "selection": "${GREEN}40" },
        { "cursor": "${ORANGE}", "background": "${ORANGE}", "selection": "${ORANGE}40" },
        { "cursor": "${CYAN}", "background": "${CYAN}", "selection": "${CYAN}40" },
        { "cursor": "${RED}", "background": "${RED}", "selection": "${RED}40" },
        { "cursor": "${YELLOW}", "background": "${YELLOW}", "selection": "${YELLOW}40" }
      ],
      "syntax": {
        "attribute": { "color": "${YELLOW}" },
        "boolean": { "color": "${ORANGE}" },
        "comment": { "color": "${FOREGROUND_INACTIVE}", "font_style": "italic" },
        "comment.doc": { "color": "${FOREGROUND_ALT}", "font_style": "italic" },
        "constant": { "color": "${ORANGE}" },
        "constructor": { "color": "${YELLOW}" },
        "embedded": { "color": "${FOREGROUND}" },
        "emphasis": { "color": "${FOREGROUND}", "font_style": "italic" },
        "emphasis.strong": { "color": "${FOREGROUND}", "font_weight": 700 },
        "enum": { "color": "${YELLOW}" },
        "function": { "color": "${BLUE}" },
        "hint": { "color": "${FOREGROUND_INACTIVE}", "font_style": "italic" },
        "keyword": { "color": "${MAGENTA}" },
        "label": { "color": "${ACCENT}" },
        "link_text": { "color": "${BLUE}", "font_style": "italic" },
        "link_uri": { "color": "${CYAN}" },
        "number": { "color": "${ORANGE}" },
        "operator": { "color": "${FOREGROUND_ALT}" },
        "predictive": { "color": "${FOREGROUND_INACTIVE}", "font_style": "italic" },
        "preproc": { "color": "${MAGENTA}" },
        "primary": { "color": "${FOREGROUND}" },
        "property": { "color": "${RED}" },
        "punctuation": { "color": "${FOREGROUND_ALT}" },
        "punctuation.bracket": { "color": "${FOREGROUND_ALT}" },
        "punctuation.delimiter": { "color": "${FOREGROUND_ALT}" },
        "punctuation.list_marker": { "color": "${RED}" },
        "punctuation.special": { "color": "${CYAN}" },
        "string": { "color": "${GREEN}" },
        "string.escape": { "color": "${CYAN}" },
        "string.regex": { "color": "${CYAN}" },
        "string.special": { "color": "${CYAN}" },
        "string.special.symbol": { "color": "${ORANGE}" },
        "tag": { "color": "${RED}" },
        "text.literal": { "color": "${GREEN}" },
        "title": { "color": "${ACCENT}", "font_weight": 700 },
        "type": { "color": "${YELLOW}" },
        "variable": { "color": "${FOREGROUND}" },
        "variable.special": { "color": "${RED}" },
        "variant": { "color": "${CYAN}" }
      }
    }
  }]
}
