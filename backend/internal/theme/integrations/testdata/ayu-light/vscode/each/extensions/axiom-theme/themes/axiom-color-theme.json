{
  "name": "Axiom",
  "type": "light",
  "$comment": "Generated by axiom from the Ayu Light theme. Rewritten on every theme change.",
  "colors": {
    "foreground": "#5c6166",
    "focusBorder": "#399ee6",
    "selection.background": "#d2d4d8",
    "widget.border": "#d2d4d8",
    "editor.background": "#f8f9fa",
    "editor.foreground": "#5c6166",
    "editor.lineHighlightBackground": "#edeff1",
    "editor.selectionBackground": "#d2d4d8",
    "editor.findMatchHighlightBackground": "#f2ae4955",
    "editorCursor.foreground": "#399ee6",
    "editorLineNumber.foreground": "#a0a6ac",
    "editorLineNumber.activeForeground": "#399ee6",
    "editorIndentGuide.background1": "#d2d4d8",
    "editorWhitespace.foreground": "#d2d4d8",
    "editorError.foreground": "#f07171",
    "editorWarning.foreground": "#f2ae49",
    "editorInfo.foreground": "#4cbf99",
    "editorGutter.addedBackground": "#6cbf49",
    "editorGutter.deletedBackground": "#f07171",
    "editorGutter.modifiedBackground": "#f2ae49",
    "editorWidget.background": "#edeff1",
    "editorGroupHeader.tabsBackground": "#edeff1",
    "tab.activeBackground": "#f8f9fa",
    "tab.activeForeground": "#5c6166",
    "tab.activeBorderTop": "#399ee6",
    "tab.inactiveBackground": "#edeff1",
    "tab.inactiveForeground": "#a0a6ac",
    "tab.border": "#edeff1",
    "activityBar.background": "#edeff1",
    "activityBar.foreground": "#5c6166",
    "activityBar.inactiveForeground": "#a0a6ac",
    "activityBarBadge.background": "#399ee6",
    "activityBarBadge.foreground": "#f8f9fa",
    "sideBar.background": "#edeff1",
    "sideBar.foreground": "#5c6166",
    "sideBarSectionHeader.background": "#edeff1",
    "list.activeSelectionBackground": "#d2d4d8",
    "list.activeSelectionForeground": "#4e5257",
    "list.hoverBackground": "#d2d4d8",
    "list.highlightForeground": "#399ee6",
    "titleBar.activeBackground": "#edeff1",
    "titleBar.activeForeground": "#5c6166",
    "titleBar.inactiveBackground": "#edeff1",
    "titleBar.inactiveForeground": "#a0a6ac",
    "statusBar.background": "#edeff1",
    "statusBar.foreground": "#5c6166",
    "statusBar.noFolderBackground": "#edeff1",
    "statusBar.debuggingBackground": "#f2ae49",
    "statusBar.debuggingForeground": "#f8f9fa",
    "panel.background": "#f8f9fa",
    "panel.border": "#d2d4d8",
    "panelTitle.activeBorder": "#399ee6",
    "input.background": "#f8f9fa",
    "input.border": "#d2d4d8",
    "input.foreground": "#5c6166",
    "dropdown.background": "#edeff1",
    "button.background": "#399ee6",
    "button.foreground": "#f8f9fa",
    "badge.background": "#399ee6",
    "badge.foreground": "#f8f9fa",
    "progressBar.background": "#399ee6",
    "textLink.foreground": "#399ee6",
    "gitDecoration.addedResourceForeground": "#6cbf49",
    "gitDecoration.modifiedResourceForeground": "#f2ae49",
    "gitDecoration.deletedResourceForeground": "#f07171",
    "gitDecoration.untrackedResourceForeground": "#4cbf99",
    "terminal.background": "#f8f9fa",
    "terminal.foreground": "#5c6166",
    "terminalCursor.foreground": "#399ee6",
    "terminal.ansiBlack": "#5c6166",
    "terminal.ansiRed": "#c2484b",
    "terminal.ansiGreen": "#358200",
    "terminal.ansiYellow": "#9c6700",
    "terminal.ansiBlue": "#0076b7",
    "terminal.ansiMagenta": "#885faf",
    "terminal.ansiCyan": "#008262",
    "terminal.ansiWhite": "#d2d4d8",
    "terminal.ansiBrightBlack": "#8b9196",
    "terminal.ansiBrightRed": "#b25700",
    "terminal.ansiBrightGreen": "#358200",
    "terminal.ansiBrightYellow": "#9c6700",
    "terminal.ansiBrightBlue": "#0076b7",
    "terminal.ansiBrightMagenta": "#885faf",
    "terminal.ansiBrightCyan": "#008262",
    "terminal.ansiBrightWhite": "#edeff1"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#a0a6ac", "fontStyle": "italic" } },
    { "scope": ["string"], "settings": { "foreground": "#6cbf49" } },
    { "scope": ["string.regexp", "constant.character.escape"], "settings": { "foreground": "#4cbf99" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"], "settings": { "foreground": "#fa8d3e" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#a37acc" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#8a9199" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#399ee6" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#f2ae49" } },
    { "scope": ["variable"], "settings": { "foreground": "#5c6166" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#8a9199", "fontStyle": "italic" } },
    { "scope": ["variable.language"], "settings": { "foreground": "#f07171" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#f07171" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#f2ae49" } },
    { "scope": ["entity.name.namespace", "entity.name.module"], "settings": { "foreground": "#4cbf99" } },
    { "scope": ["invalid"], "settings": { "foreground": "#f07171" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#399ee6", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#399ee6" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#6cbf49" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#f07171" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#f2ae49" } }
  ]
}
