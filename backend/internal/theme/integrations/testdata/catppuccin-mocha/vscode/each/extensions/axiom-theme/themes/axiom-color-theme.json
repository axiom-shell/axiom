{
  "name": "Axiom",
  "type": "dark",
  "$comment": "Generated by axiom from the Catppuccin Mocha theme. Rewritten on every theme change.",
  "colors": {
    "foreground": "#cdd6f4",
    "focusBorder": "#89b4fa",
    "selection.background": "#45475a",
    "widget.border": "#45475a",
    "editor.background": "#1e1e2e",
    "editor.foreground": "#cdd6f4",
    "editor.lineHighlightBackground": "#313244",
    "editor.selectionBackground": "#45475a",
    "editor.findMatchHighlightBackground": "#f9e2af55",
    "editorCursor.foreground": "#89b4fa",
    "editorLineNumber.foreground": "#585b70",
    "editorLineNumber.activeForeground": "#89b4fa",
    "editorIndentGuide.background1": "#45475a",
    "editorWhitespace.foreground": "#45475a",
    "editorError.foreground": "#f38ba8",
    "editorWarning.foreground": "#f9e2af",
    "editorInfo.foreground": "#94e2d5",
    "editorGutter.addedBackground": "#a6e3a1",
    "editorGutter.deletedBackground": "#f38ba8",
    "editorGutter.modifiedBackground": "#f9e2af",
    "editorWidget.background": "#313244",
    "editorGroupHeader.tabsBackground": "#313244",
    "tab.activeBackground": "#1e1e2e",
    "tab.activeForeground": "#cdd6f4",
    "tab.activeBorderTop": "#89b4fa",
    "tab.inactiveBackground": "#313244",
    "tab.inactiveForeground": "#585b70",
    "tab.border": "#313244",
    "activityBar.background": "#313244",
    "activityBar.foreground": "#cdd6f4",
    "activityBar.inactiveForeground": "#585b70",
    "activityBarBadge.background": "#89b4fa",
    "activityBarBadge.foreground": "#1e1e2e",
    "sideBar.background": "#313244",
    "sideBar.foreground": "#cdd6f4",
    "sideBarSectionHeader.background": "#313244",
    "list.activeSelectionBackground": "#45475a",
    "list.activeSelectionForeground": "#f5e0dc",
    "list.hoverBackground": "#45475a",
    "list.highlightForeground": "#89b4fa",
    "titleBar.activeBackground": "#313244",
    "titleBar.activeForeground": "#cdd6f4",
    "titleBar.inactiveBackground": "#313244",
    "titleBar.inactiveForeground": "#585b70",
    "statusBar.background": "#313244",
    "statusBar.foreground": "#cdd6f4",
    "statusBar.noFolderBackground": "#313244",
    "statusBar.debuggingBackground": "#f9e2af",
    "statusBar.debuggingForeground": "#1e1e2e",
    "panel.background": "#1e1e2e",
    "panel.border": "#45475a",
    "panelTitle.activeBorder": "#89b4fa",
    "input.background": "#1e1e2e",
    "input.border": "#45475a",
    "input.foreground": "#cdd6f4",
    "dropdown.background": "#313244",
    "button.background": "#89b4fa",
    "button.foreground": "#1e1e2e",
    "badge.background": "#89b4fa",
    "badge.foreground": "#1e1e2e",
    "progressBar.background": "#89b4fa",
    "textLink.foreground": "#89b4fa",
    "gitDecoration.addedResourceForeground": "#a6e3a1",
    "gitDecoration.modifiedResourceForeground": "#f9e2af",
    "gitDecoration.deletedResourceForeground": "#f38ba8",
    "gitDecoration.untrackedResourceForeground": "#94e2d5",
    "terminal.background": "#1e1e2e",
    "terminal.foreground": "#cdd6f4",
    "terminalCursor.foreground": "#89b4fa",
    "terminal.ansiBlack": "#1e1e2e",
    "terminal.ansiRed": "#f38ba8",
    "terminal.ansiGreen": "#a6e3a1",
    "terminal.ansiYellow": "#f9e2af",
    "terminal.ansiBlue": "#89b4fa",
    "terminal.ansiMagenta": "#cba6f7",
    "terminal.ansiCyan": "#94e2d5",
    "terminal.ansiWhite": "#cdd6f4",
    "terminal.ansiBrightBlack": "#66697f",
    "terminal.ansiBrightRed": "#fab387",
    "terminal.ansiBrightGreen": "#a6e3a1",
    "terminal.ansiBrightYellow": "#f9e2af",
    "terminal.ansiBrightBlue": "#89b4fa",
    "terminal.ansiBrightMagenta": "#cba6f7",
    "terminal.ansiBrightCyan": "#94e2d5",
    "terminal.ansiBrightWhite": "#ffffff"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#585b70", "fontStyle": "italic" } },
    { "scope": ["string"], "settings": { "foreground": "#a6e3a1" } },
    { "scope": ["string.regexp", "constant.character.escape"], "settings": { "foreground": "#94e2d5" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"], "settings": { "foreground": "#fab387" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#cba6f7" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#a6adc8" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#89b4fa" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#f9e2af" } },
    { "scope": ["variable"], "settings": { "foreground": "#cdd6f4" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#a6adc8", "fontStyle": "italic" } },
    { "scope": ["variable.language"], "settings": { "foreground": "#f38ba8" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#f38ba8" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#f9e2af" } },
    { "scope": ["entity.name.namespace", "entity.name.module"], "settings": { "foreground": "#94e2d5" } },
    { "scope": ["invalid"], "settings": { "foreground": "#f38ba8" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#89b4fa", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#89b4fa" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#a6e3a1" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#f38ba8" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#f9e2af" } }
  ]
}
