<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Installed by `axiom greeter-install` to /usr/share/polkit-1/actions:
     the prompt for updating or removing axiom's login screen, through the
     root-owned copy of greeter_install.sh (which runs the copy's own axiom
     binary; the first install runs before this exists, through plain
     pkexec) -->
<policyconfig>
  <vendor>axiom</vendor>
  <action id="org.axiom.greeter.manage">
    <description>Manage axiom's login screen</description>
    <message>Authentication is required to update or remove axiom's login screen (greetd)</message>
    <icon_name>system-lock-screen</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/axiom-greeter/scripts/greeter/greeter_install.sh</annotate>
  </action>
</policyconfig>
