# Maintainer: Travis Hepworth <travis at batk dot me>
#
# axiom built from main; axiom-shell is the same package at the latest
# release. CI pushes both to the AUR on every release tag, with .SRCINFO
# (.github/workflows/release.yml); pkgver() sets the real version at build
# time. Both keep
# their depends and optdepends in step with install.sh's tables
# (scripts/check_packages.py). docs/dev/packaging.md says how it's laid out.

pkgname=axiom-shell-git
pkgver=1.1.10.r7.g35d3a17
pkgrel=1
pkgdesc='A Quickshell desktop shell for Hyprland, sway and niri: bar, launcher, notifications, lock and login screens, overlay pages'
arch=('x86_64' 'aarch64')
url='https://github.com/axiom-shell/axiom'
license=('GPL-3.0-or-later')
# No compositor: it's the shell, not the session, and any one of
# hyprland, sway (or swayfx, which provides it) and niri runs it
provides=('axiom-shell')
conflicts=('axiom-shell')
depends=('quickshell>=0.3.2' 'curl' 'ttf-material-symbols-variable')
optdepends=(
  'hyprland: the compositor with every feature'
  'niri: run axiom under niri'
  'sway: run axiom under sway (swayfx provides it), and the compositor the login screen runs in'
  'xorg-xwayland: X11 apps under sway (Steam, games, older apps)'
  'xwayland-satellite: X11 apps under niri (Steam, games, older apps)'
  'awww: wallpapers'
  'libsecret: calendar accounts and feeds'
  'networkmanager: Wi-Fi menu and network widget'
  'pacman-contrib: package update checks'
  'wf-recorder: screen recording'
  'grim: screenshots (niri)'
  'satty: annotating screenshots'
  'libqalculate: launcher calculator'
  'ddcutil: brightness keys and OSD bar (external monitors over DDC/CI)'
  'wlsunset: night light (niri)'
  'power-profiles-daemon: power profiles'
  'xdg-desktop-portal-gtk: browse buttons for folders and importing configs'
  'greetd: axiom as the login screen (set up from Settings → Login screen)'
  'greetd-agreety: axiom as the login screen (its text fallback)'
)
makedepends=('git' 'go')
install=axiom-shell-git.install
source=("axiom::git+$url.git#branch=main")
sha256sums=('SKIP')

pkgver() {
  cd axiom
  # v1.1.10-4-gabc1234 → 1.1.10.r4.gabc1234
  git describe --long --tags --match 'v*' --abbrev=7 | sed 's/^v//;s/-\([0-9]*\)-g/.r\1.g/'
}

prepare() {
  cd axiom/backend
  go mod download
}

# The axiom binary (the shell's parent: `axiom run`) and the files a clone
# generates that it is built from: the config schema (from config/schema/)
# and the copies it embeds
build() {
  cd axiom
  export CGO_ENABLED=0 GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
  scripts/generate.sh --no-docs
  (cd backend && go build -o axiom ./cmd/axiom)
}

package() {
  cd axiom
  install -Dm755 backend/axiom "$pkgdir/usr/bin/axiom"
  local dest="$pkgdir/usr/share/axiom"
  install -d "$dest"
  cp -r --no-preserve=ownership . "$dest"
  # What only working on axiom needs (the greeter's copy leaves out the same)
  rm -rf "$dest"/{.git,tests,docs,.github,.githooks,.claude,packaging,scripts/dev,backend}
  rm -f "$dest"/{install.sh,.gitignore,.qmlformat.ini,.qmlls.ini,.shellcheckrc} \
    "$dest"/scripts/{check_*,gen_docs.py,gen_theme_template.py,ci_summary.py,run_tests.sh,release.sh,qml_modules.py,qmllint-baseline.json}
  find "$dest" -name '*.md' -delete
  # The marker the shell reads (Paths.packaged): updates come from pacman,
  # and the login screen runs this copy
  printf '%s\n' "$pkgver-$pkgrel" >"$dest/.packaged"
  # Where `axiom run` looks after ~/.config/quickshell/axiom
  install -d "$pkgdir/etc/xdg/quickshell"
  ln -s /usr/share/axiom "$pkgdir/etc/xdg/quickshell/axiom"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
