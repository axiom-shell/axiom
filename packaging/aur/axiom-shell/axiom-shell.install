post_install() {
  cat <<'EOF'
==> axiom is installed in /usr/share/axiom-shell; `axiom run` runs it.
    Start it with your compositor, by adding to its config:
      Hyprland (~/.config/hypr/hyprland.lua):
        hl.on("hyprland.start", function() hl.exec_cmd("'/usr/bin/axiom' run") end)
      sway (~/.config/sway/config):    exec '/usr/bin/axiom' run
      niri (~/.config/niri/config.kdl): spawn-sh-at-startup "'/usr/bin/axiom' run"
    Its first start walks you through the rest. An install in
    ~/.local/share/axiom-shell (install.sh's), if you have one, runs
    instead of this.
EOF
}

post_upgrade() {
  cat <<'EOF'
==> Run the new version: `axiom daemon reexec`, then `axiom restart`
    (or log out and back in).
EOF
  # greetd still starts a login screen installed before axiom's files moved
  # (scripts/greeter/ became data/greeter/), which now reads as not set up
  if grep -qs '/usr/share/axiom-greeter/scripts/' /etc/greetd/config.toml; then
    cat <<'EOF'
==> axiom's login screen was installed by an older version: set it up
    again (Settings → Login screen, which runs `axiom greeter-install`)
    before you log out.
EOF
  fi
}

pre_remove() {
  cat <<'EOF'
==> Before removing axiom: run `axiom uninstall` as each user who used it.
    It takes axiom's lines out of your compositor and app configs and puts
    back what it changed; pacman can't reach your home folder. Your backups
    (*.axiom-bak-*, *.bak-<date>) are kept and listed.
    The login screen, if installed, is removed in Settings → Login screen first.
EOF
}
