{
  "patterns": [
    {"op": "is", "value": "firefox", "regex": "\\A(?:firefox)\\z", "matches": ["firefox"], "misses": ["Firefox", "firefox-esr", "xfirefox", ""]},
    {"op": "is", "value": "org.mozilla.firefox", "regex": "\\A(?:org\\.mozilla\\.firefox)\\z", "matches": ["org.mozilla.firefox"], "misses": ["orgXmozilla.firefox"]},
    {"op": "is", "value": "a\"b\\c", "regex": "\\A(?:a\"b\\\\c)\\z", "matches": ["a\"b\\c"]},
    {"op": "is", "value": "a b(c)[d]{e}*+?|^$", "regex": "\\A(?:a b\\(c\\)\\[d\\]\\{e\\}\\*\\+\\?\\|\\^\\$)\\z", "matches": ["a b(c)[d]{e}*+?|^$"], "misses": ["a b"]},
    {"op": "is", "value": "Ünïcødé 日本", "regex": "\\A(?:Ünïcødé 日本)\\z", "matches": ["Ünïcødé 日本"]},
    {"op": "is", "value": "tab\there", "regex": "\\A(?:tab\\there)\\z", "matches": ["tab\there"]},
    {"op": "is", "value": "a\u000bb", "regex": "\\A(?:a\\x0bb)\\z", "matches": ["a\u000bb"]},
    {"op": "contains", "value": "Picture-in-Picture", "regex": "\\A(?s:.*)(?:Picture-in-Picture)(?s:.*)\\z", "matches": ["Firefox — Picture-in-Picture", "Picture-in-Picture"], "misses": ["picture-in-picture"]},
    {"op": "contains", "value": "x.y", "regex": "\\A(?s:.*)(?:x\\.y)(?s:.*)\\z", "matches": ["ax.yb"], "misses": ["axzyb"]},
    {"op": "contains", "value": "b", "regex": "\\A(?s:.*)(?:b)(?s:.*)\\z", "matches": ["a\nb\nc"]},
    {"op": "matches", "value": "^steam_app_\\d+$", "regex": "\\A(?s:.*)(?:\\Asteam_app_[0-9]+\\z)(?s:.*)\\z", "matches": ["steam_app_570"], "misses": ["steam_app_", "steam_app_570x", "xsteam_app_1", "steam_app_1\n"]},
    {"op": "matches", "value": "\\w+", "regex": "\\A(?s:.*)(?:[0-9A-Z_a-z]+)(?s:.*)\\z", "matches": ["a"], "misses": ["éé"]},
    {"op": "matches", "value": "\\s", "regex": "\\A(?s:.*)(?:[\\t\\n\\f\\r ])(?s:.*)\\z", "matches": ["a b"], "misses": ["ab"]},
    {"op": "matches", "value": ".", "regex": "\\A(?s:.*)(?:(?-s:.))(?s:.*)\\z", "matches": ["a"], "misses": ["\n", ""]},
    {"op": "matches", "value": "(?s).", "regex": "\\A(?s:.*)(?:(?s:.))(?s:.*)\\z", "matches": ["\n"]},
    {"op": "matches", "value": "(foo|bar)baz", "regex": "\\A(?s:.*)(?:(?:foo|bar)baz)(?s:.*)\\z", "matches": ["xbarbazx"], "misses": ["foobar"]},
    {"op": "matches", "value": "(?P<n>a)b", "regex": "\\A(?s:.*)(?:ab)(?s:.*)\\z", "matches": ["ab"]},
    {"op": "matches", "value": "(?i)firefox", "regex": "\\A(?s:.*)(?:(?i:FIREFOX))(?s:.*)\\z", "matches": ["FireFox"]},
    {"op": "matches", "value": "[[:alpha:]]+", "regex": "\\A(?s:.*)(?:[A-Za-z]+)(?s:.*)\\z", "matches": ["a"], "misses": ["1"]},
    {"op": "matches", "value": "a{2,5}?", "regex": "\\A(?s:.*)(?:a{2,5}?)(?s:.*)\\z", "matches": ["aa"], "misses": ["a"]},
    {"op": "matches", "value": "[\\[\\]&~-]", "regex": "\\A(?s:.*)(?:[&\\-\\[\\]~])(?s:.*)\\z", "matches": ["~", "&", "-", "["], "misses": ["a"]},
    {"op": "matches", "value": "foo|bar", "regex": "\\A(?s:.*)(?:foo|bar)(?s:.*)\\z", "matches": ["xbar"], "misses": ["fo"]},
    {"op": "matches", "value": "[^\\n]", "regex": "\\A(?s:.*)(?:(?-s:.))(?s:.*)\\z", "matches": ["a"], "misses": ["\n"]},
    {"op": "matches", "value": "\\\\p", "regex": "\\A(?s:.*)(?:\\\\p)(?s:.*)\\z", "matches": ["\\p"]},
    {"op": "matches", "value": "(?U)a+", "regex": "\\A(?s:.*)(?:a+?)(?s:.*)\\z", "matches": ["a"]},
    {"op": "matches", "value": "\\v", "regex": "\\A(?s:.*)(?:\\x0b)(?s:.*)\\z", "matches": ["\u000b"]},
    {"op": "matches", "value": "[\\x00-\\x0b]", "regex": "\\A(?s:.*)(?:[\\x00-\\x0b])(?s:.*)\\z", "matches": ["\u000b"], "misses": ["a"]},
    {"op": "matches", "value": "(?m)^a", "refused": "(?m)"},
    {"op": "matches", "value": "(?m:a$)", "refused": "(?m)"},
    {"op": "matches", "value": "\\Qa.b\\E", "refused": "\\Q…\\E"},
    {"op": "matches", "value": "\\pL", "refused": "\\p"},
    {"op": "matches", "value": "\\p{Greek}", "refused": "\\p"},
    {"op": "matches", "value": "\\PL", "refused": "\\p"},
    {"op": "matches", "value": "\\bword\\b", "refused": "\\b"},
    {"op": "matches", "value": "\\B", "refused": "\\b"},
    {"op": "matches", "value": "(?=a)", "invalid": true},
    {"op": "matches", "value": "(a)\\1", "invalid": true},
    {"op": "matches", "value": "a{1001}", "invalid": true},
    {"op": "matches", "value": "[", "invalid": true},
    {"op": "matches", "value": "\\C", "invalid": true}
  ],
  "negations": [
    {"values": ["a", "b.c"], "regex": "\\A(?:(?:a)|(?:b\\.c))\\z", "matches": ["a", "b.c"], "misses": ["b-c", "ab", ""]},
    {"values": ["steam"], "regex": "\\A(?:(?:steam))\\z", "matches": ["steam"], "misses": ["steam2"]}
  ]
}
